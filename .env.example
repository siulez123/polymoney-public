# Copy to .env and fill in the values.
# Never commit .env!

# Private key exported from Polymarket Settings (0x...)
PRIVATE_KEY=

# Live only: your own funder/deposit wallet address. Never commit real values.
DEPOSIT_WALLET_ADDRESS=

# ── CLOB credentials (optional) ───────────────────────────────────────────────
# For signature_type 0/1/2 only. Do not use with signature_type: 3 — the bot derives credentials for the profile.
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# Alternative config.yaml path (optional)
# CONFIG_PATH=./config.yaml

# Log level override (optional)
# LOG_LEVEL=debug

# Telegram (create a bot via @BotFather, get chat_id via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard access token (optional). Without it, /pnl is public.
# Generate with: openssl rand -hex 32
# Access with: https://your-bot.up.railway.app/pnl?token=VALUE
# DASHBOARD_TOKEN=

# Web Push (background WON/LOST notifications). Optional —
# if empty, the bot generates and saves keys in data/vapid.json on first startup.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com


# Copia para .env e preenche os valores.
# Nunca commits o .env!

# Chave privada exportada nas Settings do Polymarket (0x...)
PRIVATE_KEY=

# Live only: your own funder/deposit wallet address. Never commit real values.
DEPOSIT_WALLET_ADDRESS=

# ── Credenciais CLOB (opcional) ───────────────────────────────────────────────
# Só para signature_type 0/1/2. Com signature_type: 3 NÃO uses — o bot deriva para o perfil.
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# Caminho alternativo para config.yaml (opcional)
# CONFIG_PATH=./config.yaml

# Nível de log override (opcional)
# LOG_LEVEL=debug

# Telegram (cria bot via @BotFather, obtém chat_id via @userinfobot ou getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token para proteger o dashboard (opcional). Sem isto, /pnl fica público.
# Gera com: openssl rand -hex 32
# Acede com: https://teu-bot.up.railway.app/pnl?token=VALOR
# DASHBOARD_TOKEN=

# Web Push (notificações GANHOU/PERDEU em background). Opcional —
# se vazio, o bot gera e grava em data/vapid.json no primeiro arranque.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com

